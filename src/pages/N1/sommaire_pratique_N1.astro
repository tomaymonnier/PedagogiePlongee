---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Session from '../../components/Session.astro';
import '../../styles/style.css';
---

<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Sommaire et checklist de progression des séances pratiques de formation FFESSM Plongeur Niveau 1 (PE20), avec correspondance indicative aux compétences du MFT." />
  <title>Formation N1 — Sommaire des séances pratiques</title>
</head>
<body>
  <Header
    eyebrow="Formation fédérale · Plongée bouteille"
    title="Formation N1 — séances pratiques"
    description="Sommaire de progression du plongeur Niveau 1 (PE20), pour préparer, suivre et valider les séances pratiques. Chaque fiche de séance sera accessible depuis son lien dédié."
  />

  <main class="container">
    <div class="notice">
      <strong>Référentiel et usage.</strong> Cette checklist est une proposition d’organisation pédagogique, pas un découpage officiel imposé par la FFESSM. Les séances peuvent être regroupées, répétées ou réordonnées selon le milieu, les besoins du plongeur et les choix de l’encadrant. Les compétences ci-dessous renvoient aux grandes compétences du MFT N1 ; vérifier la version en vigueur du <a href="https://mft.ffessm.fr/" target="_blank" rel="noopener">Manuel de Formation Technique (MFT)</a> et les consignes de la structure.
    </div>

    <div class="progressbox" aria-live="polite">
      <strong>Avancement des séances</strong>
      <div class="progressline"><div id="progressFill"></div></div>
      <div class="progress-meta"><span id="progressText">0 séance cochée</span><span id="progressPercent">0 %</span></div>
      <p class="small">Les cases servent au suivi de cette page dans le navigateur courant. Elles ne remplacent pas le carnet de plongée, la fiche individuelle de suivi ni la validation par l’encadrant.</p>
    </div>

    <div class="toolbar">
      <button class="primary" type="button" id="expandAll">Déplier toutes les séances</button>
      <button type="button" id="collapseAll">Replier toutes les séances</button>
      <button type="button" id="resetChecks">Réinitialiser les cases</button>
      <button type="button" onclick="window.print()">Imprimer / enregistrer en PDF</button>
    </div>

    <nav class="quicknav" aria-label="Accès rapide">
      <a href="#preparation">Préparation & matériel</a>
      <a href="#fondamentaux">Fondamentaux en piscine</a>
      <a href="#integration">Intégration & sécurité</a>
      <a href="#milieu-naturel">Milieu naturel</a>
      <a href="#competences">Repères MFT</a>
    </nav>

    <!-- SECTION 1 -->
    <div class="section-head" id="preparation">
      <div>
        <h2>Préparation et matériel</h2>
        <p>Familiarisation progressive, autonomie adaptée et contrôles de sécurité.</p>
      </div>
      <p>À sec / bord de bassin</p>
    </div>

    <div class="session-list">
      <Session
        id="s01"
        title="S01 — Accueil, équipement et contrôles pré-plongée"
        tagClass="land"
        tagLabel="À sec / bord"
        competenceTags="C1 · C3 · C6"
        description="Identifier le matériel, s’équiper et se déséquiper avec aide si nécessaire, vérifier l’équipement et comprendre le rôle du binôme."
        mftText="C1 — Utiliser l’équipement de plongée ; C3 — Évoluer en palanquée guidée ; C6 — Participer à la sécurité en plongée."
        courseUrl="/N1/Pratique/N1_C1_equipement"
        checkpoints={[
          "Matériel adapté, état apparent vérifié et bouteille manipulée en sécurité.",
          "Gilet, détendeur, manomètre et lestage identifiés ; fonctionnement expliqué au niveau attendu.",
          "Robinet ouvert selon la procédure de la structure, contrôle de pression et essai respiratoire.",
          "Contrôle croisé avec le binôme ; capacité à signaler un problème et demander de l’aide."
        ]}
      />

      <Session
        id="s02"
        title="S02 — Mise à l’eau et sortie de l’eau"
        tagClass="water"
        tagLabel="Bord / bassin"
        competenceTags="C2 · C3 · C6"
        description="Choisir et réaliser une entrée et une sortie adaptées au site, au matériel et aux consignes de l’encadrant."
        mftText="C2 — Évoluer en environnement aquatique et subaquatique ; C3 — Évoluer en palanquée guidée ; C6 — Participer à la sécurité en plongée."
        courseUrl="Pratique/N1_C2_Maitrise_Immersion_Stabilisation.html"
        checkpoints={[
          "Écoute du briefing, vérification de la zone et attente du signal de départ.",
          "Entrée maîtrisée selon la méthode enseignée et les conditions locales.",
          "Regroupement en surface, contrôle du binôme et signalement de tout inconfort.",
          "Sortie sans précipitation, avec assistance adaptée et respect des consignes du site."
        ]}
      />
    </div>

    <!-- SECTION 2 -->
    <div class="section-head" id="fondamentaux">
      <div>
        <h2>2. Fondamentaux en milieu protégé</h2>
        <p>Construire les automatismes sans surcharge, puis combiner les actions.</p>
      </div>
      <p>Piscine / faible profondeur</p>
    </div>

    <div class="session-list">
      <Session
        id="s03"
        title="S03 — Immersion, retour en surface et gestion de la pression"
        tagClass="water"
        tagLabel="Milieu protégé"
        competenceTags="C2 · C3 · C6"
        description="S’immerger progressivement, équilibrer les oreilles sans forcer, contrôler la descente et revenir en surface sur consigne."
        mftText="C2 — Évoluer en environnement aquatique et subaquatique ; C3 — Évoluer en palanquée guidée ; C6 — Participer à la sécurité en plongée."
        courseUrl="PLACEHOLDER_COURS_N1_IMMERSION.html"
        checkpoints={[
          "Descente progressive, expiration/ventilation continue et équilibrage précoce et régulier.",
          "Arrêt immédiat de la descente en cas de douleur ou de difficulté d’équilibrage ; ne jamais forcer.",
          "Repérage de l’encadrant et du binôme ; remontée contrôlée selon le signal et la procédure apprise.",
          "Retour en surface, ventilation normale et signal de fin d’exercice."
        ]}
      />

      <Session
        id="s04"
        title="S04 — Ventilation, détendeur et reprise d’embout"
        tagClass="water"
        tagLabel="Milieu protégé"
        competenceTags="C1 · C2 · C6"
        description="Respirer calmement sur détendeur, retrouver ou reprendre l’embout et maintenir une ventilation continue."
        mftText="C1 — Utiliser l’équipement de plongée ; C2 — Évoluer en environnement aquatique et subaquatique ; C6 — Participer à la sécurité en plongée."
        courseUrl="PLACEHOLDER_COURS_N1_DETENDEUR.html"
        checkpoints={[
          "Respiration continue, calme et sans apnée volontaire pendant l’exercice.",
          "Reprise d’embout adaptée à la technique enseignée et validée par l’encadrant.",
          "Capacité à interrompre l’exercice et à exprimer un inconfort par un signe convenu.",
          "Rappel : ne jamais retenir sa respiration lors d’une remontée."
        ]}
      />

      <Session
        id="s05"
        title="S05 — Vider le masque et retrouver ses repères"
        tagClass="water"
        tagLabel="Milieu protégé"
        competenceTags="C2 · C3 · C6"
        description="Accepter une entrée d’eau dans le masque, le vider progressivement et conserver une respiration régulière."
        mftText="C2 — Évoluer en environnement aquatique et subaquatique ; C3 — Évoluer en palanquée guidée ; C6 — Participer à la sécurité en plongée."
        courseUrl="PLACEHOLDER_COURS_N1_MASQUE.html"
        checkpoints={[
          "Progression par étapes, sans contrainte excessive ni précipitation.",
          "Expiration par le nez et action de la main adaptées à la technique enseignée.",
          "Conservation de l’embout en bouche et reprise d’une ventilation normale.",
          "Possibilité de remonter ou d’arrêter l’exercice à tout moment sur demande."
        ]}
      />

      <Session
        id="s06"
        title="S06 — Équilibrage, lestage et stabilisation"
        tagClass="water"
        tagLabel="Milieu protégé"
        competenceTags="C1 · C2 · C6"
        description="Comprendre l’action du gilet et du lestage, ajuster sa flottabilité et se stabiliser sans mouvements brusques."
        mftText="C1 — Utiliser l’équipement de plongée ; C2 — Évoluer en environnement aquatique et subaquatique ; C6 — Participer à la sécurité en plongée."
        courseUrl="PLACEHOLDER_COURS_N1_EQUILIBRAGE.html"
        checkpoints={[
          "Ajouts et retraits d’air mesurés, en tenant compte de la profondeur et de la flottabilité.",
          "Ventilation continue ; stabilisation sans s’accrocher au fond ni endommager le milieu.",
          "Remontée contrôlée et gestion de l’air du gilet selon les consignes de l’encadrant.",
          "Lestage évalué par l’encadrant, sans chercher à compenser un problème de technique par un excès de plomb."
        ]}
      />

      <Session
        id="s07"
        title="S07 — Propulsion, déplacement et position dans l’eau"
        tagClass="water"
        tagLabel="Milieu protégé"
        competenceTags="C2 · C3 · C7"
        description="Se déplacer à allure maîtrisée, adopter une position stable et limiter les contacts avec le fond."
        mftText="C2 — Évoluer en environnement aquatique et subaquatique ; C3 — Évoluer en palanquée guidée ; C7 — Connaître et respecter l’environnement marin."
        courseUrl="PLACEHOLDER_COURS_N1_PROPULSION.html"
        checkpoints={[
          "Propulsion adaptée, déplacements sans agitation excessive.",
          "Maintien de la profondeur et de la distance avec le groupe selon le niveau atteint.",
          "Pas d’appui ni de palmage destructeur sur le fond ; attention au matériel et aux autres plongeurs."
        ]}
      />

      <Session
        id="s08"
        title="S08 — Communication subaquatique et réponse aux signaux"
        tagClass="water"
        tagLabel="Milieu protégé"
        competenceTags="C3 · C6"
        description="Reconnaître les signes essentiels, répondre clairement et signaler une difficulté ou une demande de remontée."
        mftText="C3 — Évoluer en palanquée guidée ; C6 — Participer à la sécurité en plongée."
        courseUrl="Pratique/N1_C3_Evoluer_En _Palanquee_Guidee.html"
        checkpoints={[
          "Compréhension et réponse aux signes de communication convenus au briefing.",
          "Signal clair, attente de l’accusé de réception et maintien du contact visuel.",
          "Reconnaissance des signaux de fin de plongée, de problème et de remontée selon les procédures enseignées."
        ]}
      />
    </div>

    <!-- SECTION 3 -->
    <div class="section-head" id="integration">
      <div>
        <h2>3. Intégration, sécurité et comportement en palanquée</h2>
        <p>Combiner les acquis, rester proche de l’encadrant et réagir sans improviser.</p>
      </div>
      <p>Piscine / milieu protégé</p>
    </div>

    <div class="session-list">
      <Session
        id="s09"
        title="S09 — Évolution en palanquée guidée"
        tagClass="water"
        tagLabel="Milieu protégé"
        competenceTags="C3 · C6"
        description="Suivre l’encadrant, conserver une place adaptée, surveiller ses paramètres et rester attentif au binôme."
        mftText="C3 — Évoluer en palanquée guidée ; C6 — Participer à la sécurité en plongée."
        courseUrl="Pratique/N1_C3_Evoluer_En _Palanquee_Guidee.html"
        checkpoints={[
          "Respect des consignes, du trajet et de la profondeur fixés par l’encadrant.",
          "Contact visuel régulier, proximité adaptée et absence d’initiative de séparation.",
          "Surveillance du manomètre à la fréquence demandée et communication de la pression.",
          "Réaction aux changements de direction, arrêts et consignes de remontée."
        ]}
      />

      <Session
        id="s10"
        title="S10 — Réagir à une difficulté et participer à la sécurité"
        tagClass="water"
        tagLabel="Milieu protégé"
        competenceTags="C3 · C6"
        description="Identifier une situation inhabituelle, alerter l’encadrant, appliquer les gestes appris et rester dans son rôle de plongeur N1."
        mftText="C3 — Évoluer en palanquée guidée ; C6 — Participer à la sécurité en plongée."
        courseUrl="PLACEHOLDER_COURS_N1_SECURITE.html"
        checkpoints={[
          "Reconnaissance d’un signe de difficulté et alerte rapide de l’encadrant.",
          "Réponse aux consignes sans geste improvisé ni mise en danger du groupe.",
          "Exercices adaptés au niveau, scénarisés et supervisés par l’encadrant ; pas de simulation dangereuse.",
          "Rappel des limites du N1 : plongeur encadré, pas de prise en charge autonome d’un secours complexe."
        ]}
      />

      <Session
        id="s11"
        title="S11 — Respect du milieu et maîtrise des contacts"
        tagClass="water"
        tagLabel="Milieu protégé / naturel"
        competenceTags="C2 · C7"
        description="Observer sans dégrader, maîtriser sa flottabilité et adapter sa trajectoire pour préserver les organismes et le site."
        mftText="C2 — Évoluer en environnement aquatique et subaquatique ; C7 — Connaître et respecter l’environnement marin."
        courseUrl="PLACEHOLDER_COURS_N1_ENVIRONNEMENT.html"
        checkpoints={[
          "Absence de contact volontaire avec le fond, les animaux et les végétaux.",
          "Position et palmage adaptés ; pas de prélèvement ni de nourrissage.",
          "Comportement conforme aux règles locales et aux consignes de l’encadrant."
        ]}
      />

      <Session
        id="s12"
        title="S12 — Parcours intégré et bilan des acquis en milieu protégé"
        tagClass="water"
        tagLabel="Milieu protégé"
        competenceTags="C1 · C2 · C3 · C6 · C7"
        description="Enchaîner équipement, mise à l’eau, immersion, stabilisation, communication, déplacement et retour en surface dans un scénario cohérent."
        mftText="mobilisation transversale de C1, C2, C3, C6 et C7, au niveau attendu en formation N1."
        courseUrl="PLACEHOLDER_COURS_N1_INTEGRATION.html"
        checkpoints={[
          "Enchaînement sans perte de contrôle de la ventilation, de la profondeur ou du groupe.",
          "Détection des points à retravailler et définition d’une remédiation ciblée.",
          "Évaluation formative : noter ce qui est acquis, en cours d’acquisition ou à reprendre."
        ]}
      />
    </div>

    <!-- SECTION 4 -->
    <div class="section-head" id="milieu-naturel">
      <div>
        <h2>4. Séances en milieu naturel</h2>
        <p>Transférer les acquis en conditions réelles ; les plongées sont adaptées au site et à la progression.</p>
      </div>
      <p>Mer / lac / carrière</p>
    </div>

    <div class="session-list">
      <Session
        id="s13"
        title="S13 — Première plongée d’adaptation en milieu naturel"
        tagClass="open"
        tagLabel="Milieu naturel"
        competenceTags="C1 · C2 · C3 · C6 · C7"
        description="Découvrir le site, prendre ses repères, retrouver les automatismes et rester en confiance avec l’encadrant."
        mftText="mobilisation adaptée de C1, C2, C3, C6 et C7 selon les conditions de la plongée."
        courseUrl="PLACEHOLDER_COURS_N1_MN_ADAPTATION.html"
        checkpoints={[
          "Briefing spécifique au site, conditions, organisation de la palanquée et consignes de retour.",
          "Immersion et évolution adaptées à la visibilité, au courant, à la température et à l’aisance du plongeur.",
          "Contrôle régulier du confort, de la pression et du contact avec l’encadrant."
        ]}
      />

      <Session
        id="s14"
        title="S14 — Stabilisation et déplacement en milieu naturel"
        tagClass="open"
        tagLabel="Milieu naturel"
        competenceTags="C2 · C3 · C6 · C7"
        description="Consolider la flottabilité, l’orientation simple, la propulsion et le respect du milieu dans les conditions du site."
        mftText="C2 — Évoluer en environnement aquatique et subaquatique ; C3 — Évoluer en palanquée guidée ; C6 — Participer à la sécurité ; C7 — Respecter l’environnement marin."
        courseUrl="PLACEHOLDER_COURS_N1_MN_DEPLACEMENT.html"
        checkpoints={[
          "Profondeur et allure compatibles avec la palanquée et les conditions réelles.",
          "Ventilation et équilibre stables ; déplacements sans contact dommageable.",
          "Communication des paramètres et maintien du contact avec le groupe."
        ]}
      />

      <Session
        id="s15"
        title="S15 — Réinvestissement des gestes techniques en milieu naturel"
        tagClass="open"
        tagLabel="Milieu naturel"
        competenceTags="C1 · C2 · C3 · C6"
        description="Revoir, dans des conditions maîtrisées, les gestes utiles : masque, détendeur, stabilisation, signes et remontée encadrée."
        mftText="C1, C2, C3 et C6 selon les gestes effectivement travaillés et les conditions de sécurité."
        courseUrl="PLACEHOLDER_COURS_N1_MN_GESTES.html"
        checkpoints={[
          "Exercices annoncés au briefing, progressifs et compatibles avec les conditions du jour.",
          "Maintien de la ventilation, de la profondeur et du contact avec l’encadrant.",
          "Pas de répétition systématique si la situation n’est pas adaptée ; priorité à la sécurité et au confort."
        ]}
      />

      <Session
        id="s16"
        title="S16 — Plongée de synthèse et bilan de progression"
        tagClass="open"
        tagLabel="Milieu naturel"
        competenceTags="C1 · C2 · C3 · C6 · C7 · C8"
        description="Observer l’aptitude à plonger encadré à 20 m dans le cadre prévu, consolider les acquis et identifier les derniers besoins de formation."
        mftText="synthèse des compétences pratiques et des connaissances en appui ; la validation du brevet relève de l’équipe pédagogique habilitée et du suivi de formation."
        courseUrl="PLACEHOLDER_COURS_N1_SYNTHESE.html"
        checkpoints={[
          "Préparation, équipement, contrôles croisés et compréhension du briefing.",
          "Évolution au sein de la palanquée, communication, gestion des paramètres et respect du milieu.",
          "Retour et déséquipement dans de bonnes conditions ; débriefing précis et traçable.",
          "Les plongées en milieu naturel exigées par le référentiel et les conditions de certification sont vérifiées séparément."
        ]}
      />
    </div>

    <!-- SECTION 5 -->
    <div class="section-head" id="competences">
      <div>
        <h2>5. Repères des compétences MFT</h2>
        <p>Correspondance de travail pour naviguer dans les fiches de séance.</p>
      </div>
    </div>
    <table>
      <thead>
        <tr>
          <th>Repère</th>
          <th>Compétence générale</th>
          <th>Exemples de séances associées</th>
        </tr>
      </thead>
      <tbody>
        <tr><td><strong>C1</strong></td><td>Utiliser l’équipement de plongée</td><td>S01, S04, S06, S12, S13, S15, S16</td></tr>
        <tr><td><strong>C2</strong></td><td>Évoluer en environnement aquatique et subaquatique</td><td>S02 à S07, S11 à S16</td></tr>
        <tr><td><strong>C3</strong></td><td>Évoluer en palanquée guidée</td><td>S01 à S03, S05, S07 à S10, S12 à S16</td></tr>
        <tr><td><strong>C6</strong></td><td>Participer à la sécurité en plongée</td><td>S01 à S06, S08 à S10, S12 à S16</td></tr>
        <tr><td><strong>C7</strong></td><td>Connaître et respecter l’environnement marin</td><td>S07, S11 à S14, S16</td></tr>
        <tr><td><strong>C8</strong></td><td>Connaissances en appui des compétences</td><td>Apports théoriques associés aux séances et bilan S16</td></tr>
      </tbody>
    </table>
    <p class="small" style="margin-top:12px">
      Les associations séance/compétence sont indicatives : une séance peut contribuer à plusieurs compétences, et une compétence se construit sur plusieurs séances. Les codes et intitulés doivent être contrôlés dans la version courante du MFT N1 PE20 avant usage comme document officiel de suivi.
    </p>

    <!-- SECTION 6 -->
    <div class="section-head">
      <div>
        <h2>6. Suivi pédagogique individuel</h2>
        <p>À compléter après observation de la pratique.</p>
      </div>
    </div>
    <table>
      <thead>
        <tr>
          <th>Élément de suivi</th>
          <th>Notes de l’encadrant</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>Points acquis / réussites observées</td><td style="height:52px"></td></tr>
        <tr><td>Points à retravailler</td><td style="height:52px"></td></tr>
        <tr><td>Adaptations ou remédiations prévues</td><td style="height:52px"></td></tr>
        <tr><td>Date / encadrant / conditions de pratique</td><td style="height:52px"></td></tr>
      </tbody>
    </table>

    <Footer version="1.0" />
  </main>

  <script>
    (function () {
      const checks = Array.from(document.querySelectorAll('.session-check'));
      const fill = document.getElementById('progressFill');
      const text = document.getElementById('progressText');
      const percent = document.getElementById('progressPercent');

      function update() {
        const done = checks.filter((c) => c.checked).length;
        const pct = checks.length ? Math.round((done / checks.length) * 100) : 0;
        if (fill) fill.style.width = pct + '%';
        if (text) text.textContent = done + ' séance' + (done > 1 ? 's' : '') + ' cochée' + (done > 1 ? 's' : '');
        if (percent) percent.textContent = pct + ' %';
      }

      checks.forEach((c) => c.addEventListener('change', update));

      document.getElementById('expandAll')?.addEventListener('click', () => {
        document.querySelectorAll('details').forEach((d) => (d.open = true));
      });

      document.getElementById('collapseAll')?.addEventListener('click', () => {
        document.querySelectorAll('details').forEach((d) => (d.open = false));
      });

      document.getElementById('resetChecks')?.addEventListener('click', () => {
        if (confirm('Réinitialiser toutes les cases cochées ?')) {
          checks.forEach((c) => (c.checked = false));
          update();
        }
      });

      update();
    })();
  </script>
</body>
</html>
