const summaryData = [
  { label: "Milieu", value: "Milieu protégé" },
  { label: "Compétences", value: "C1 · C2 · C6" },
  { label: "Durée indicative", value: "45 à 60 min" }
];

const evaluationCriteria = [
  "Identifie les commandes du gilet et du système de lestage",
  "Comprend l'effet du gonflage et de la purge sur la flottabilité",
  "Comprend l'influence de la ventilation sur la position",
  "Effectue de petites corrections plutôt que des actions brusques",
